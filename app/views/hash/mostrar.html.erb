<h1>Datos personales</h1>

<table>
  <tr>
    <th>Nombre</th>
    <td><%= @datos[:nombre] %></td>
  </tr>
  <tr>
    <th>Apellido</th>
    <td><%= @datos[:apellido] %></td>
  </tr>
  <tr>
    <th>Teléfono</th>
    <td><%= @datos[:telefono] %></td>
  </tr>
  <tr>
    <th>Correo electrónico</th>
    <td><%= @datos[:email] %></td>
  </tr>
</table>
